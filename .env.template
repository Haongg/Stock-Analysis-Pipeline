# ============================================================
# Environment Variable Template
# Copy this file to .env and fill in the values.
# NEVER commit the actual .env file to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Application ---
DATABASE_URL=
MLFLOW_TRACKING_URI=

# --- Model serving ---
MODEL_NAME=stock_price_predictor
# Use a version number (e.g. "1"), "latest", or an alias prefixed with "@"
# (e.g. "@champion").  The trainer automatically sets the "champion" alias on
# every newly trained version (MLflow 3.x alias-based promotion).
MODEL_STAGE=latest
FLINK_MODEL_PATH=models/lstm_latest.onnx
FLINK_SCALER_PATH=models/feature_scaler.pkl
FLINK_MODEL_VERSION=local
FLINK_MODEL_RELOAD_ENABLED=true
FLINK_MODEL_RELOAD_INTERVAL_SECONDS=300
LSTM_SEQUENCE_LENGTH=30
MLFLOW_MODEL_URI=
MLFLOW_ONNX_ARTIFACT_NAME=model.onnx
MLFLOW_SCALER_ARTIFACT_NAME=feature_scaler.pkl

# --- Training ---
TRAIN_TICKERS=AAPL MSFT GOOG
TRAIN_START=2020-01-01
RF_N_ESTIMATORS=100
RF_MAX_DEPTH=10

# --- Logging ---
LOG_LEVEL=INFO

# ---- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
KAFKA_TOPIC_RAW=stock.raw.ohlcv
KAFKA_CLIENT_ID=stock-producer

# --- Streaming Ingestion ---
STREAM_TICKERS=AAPL MSFT 
STREAM_INTERVAL=300

# --- Elasticsearch ---
ES_HOST=localhost
ES_PORT=9200
ES_SCHEME=http
ES_USER=
ES_PASSWORD=
ES_BULK_BATCH_SIZE=100
ES_BULK_FLUSH_INTERVAL_SECONDS=5
ES_REQUEST_TIMEOUT_SECONDS=30
ES_CORE_POOL_SIZE=4
ES_MAX_POOL_SIZE=8
ES_HTTP_COMPRESS=true
ES_CLUSTER_HEALTH_TIMEOUT_SECONDS=5
ES_FEATURE_INDEX=stock-engineered-features
ES_PREDICTION_INDEX=stock-predictions
ES_ILM_ENABLED=true
ES_ILM_POLICY_NAME=stock-analysis-90d-policy
ES_INDEX_RETENTION_DAYS=90
ES_DAILY_INDEX_ENABLED=true

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USERNAME=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_ADMIN_EMAIL=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW_DB_NAME=
AIRFLOW_CONN_ELASTICSEARCH_DEFAULT=http://es01:9200
AIRFLOW_CONN_POSTGRES_DEFAULT=
AIRFLOW_CONN_MLFLOW_DEFAULT=http://mlflow:5000
AIRFLOW_CONN_FLINK_DEFAULT=http://stock-jobmanager:8081
